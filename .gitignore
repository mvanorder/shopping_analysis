.idea/

# Environment files with real credentials — commit only the .example templates.
.env
.env.dev
.env.staging
.env.prod

# Secret files — commit only the .example templates.
secrets/*
!secrets/*.example

# Git worktree
.worktree/

# Claude local settings
.claude/settings.local.json

# Jupyter notebooks
*.ipynb

# Sandbox for storing temporary files, experiments, and other non-essential data.
sandbox/
