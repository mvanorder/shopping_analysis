# Copy to frontend/.env for local overrides. Expo inlines EXPO_PUBLIC_* vars
# into the bundle at build time (restart the dev server after changing them).

# Base URL of the backend API. Leave unset for local dev: the app then targets
# the FastAPI dev server on port 8000 of whatever host serves the JS bundle
# (localhost for web / the iOS simulator, the dev machine's LAN IP on device).
# Set it to point at a deployed backend, e.g.:
# EXPO_PUBLIC_API_URL=https://api.example.com
